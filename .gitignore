# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# virtual environments
venv/
.venv/
.venv-*/

# IDE
.idea/
.vscode/
.vs/

# tooling
.pytest_cache/
.ipynb_checkpoints/

# generated at runtime (kept out of the repo)
*.log
logs/
# lattice.txt is regenerated from lattice_mulp.txt on every run
examples/*/InputFile/lattice.txt
# simulation outputs produced by the smoke tests
tests/_output/
# example outputs: regenerated by every run (and they record absolute local paths)
examples/*/OutputFile/

# front end (the build output in avas/gui/web is committed)
frontend/node_modules/
.dev-gui.json

# WebView2 bootstrapper, fetched by packaging/fetch_webview2.py
packaging/redist/
tests/_output_gui/
tests/_output_assistant/
# build stamp written by packaging/build.py
avas/_build.json
# assistant work folders inside projects (sandbox runs, backups)
.avas_ai/
